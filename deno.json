{
  "tasks": {
    "test": "deno test --allow-net --allow-read --allow-env --unstable tests",
    "lint": "deno lint --unstable",
    "fmt": "deno fmt",
    "example": "deno run --watch --allow-net --allow-read example/main.ts"
  },
  "exports": {
    ".": "./src/mod.ts"
  },
  "include": [
      "LICENSE",
      "README.md",
      "VERSION",
      "src/**/*.ts"
    ],
  "name": "@vanaware/wsrouter",
  "version": "0.1.0",
  "license": "MIT",
  "description": "A WebSocket router for Deno",
  "repository": {
    "type": "git",
    "url": "https://github.com/vanaware/wsrouter"
  },
  "type": "module",
  "test": {
    "unstable": true
  },
  "lint": {
    "files": ["src/**/*.ts", "tests/**/*.ts"]
  },
  "fmt": {
    "files": ["src/**/*.ts", "tests/**/*.ts"]
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.20",
    "@std/media_types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.1",
    "@std/fs": "jsr:@std/fs@^1.0.19"
  }
}