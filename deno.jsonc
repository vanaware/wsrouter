{
  "tasks": {
    "test": "deno test -P",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt-check": "deno fmt --check",
    "lint-fix": "deno lint --fix",
    "check-all": "deno task check && deno task lint && deno task fmt --check && deno task test",
    "tests": "deno task check && deno task test",
    "check": "deno check src/**/*.ts tests/**/*.ts example/**/*.ts",
    "start": "deno run --allow-read --allow-net --allow-env example/principal/main.ts",
    "dev": "deno run --allow-read --allow-net --allow-env --watch example/principal/main.ts",
    "example": "deno run --allow-read --allow-net --allow-env --watch example/jwt/main.ts"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./deno": "./src/deno.ts",
    "./deno-serve-dir": "./src/deno-serve-dir.ts",
    "./adapters/deno": "./src/adapters/deno.ts",
    "./adapters/deno-serve-dir": "./src/adapters/deno-serve-dir.ts"
  },
  "include": [
      "LICENSE",
      "README.md",
      "VERSION",
      "src/**/*.ts"
    ],
  "name": "@vanaware/wsrouter",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Vanaware",
  "description": "A WebSocket router for Deno",
  "repository": {
    "type": "git",
    "url": "https://github.com/vanaware/wsrouter"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "esnext", "deno.ns"],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "type": "module",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/http": "jsr:@std/http@^1",
    "@std/media-types": "jsr:@std/media-types@^1", //uso futuro
    "@std/path": "jsr:@std/path@^1",
    "jose": "https://deno.land/x/jose@v5.2.0/index.ts"
  },
     // 📦 Gerenciamento de Dependências
  "minimumDependencyAge": 60,
  "nodeModulesDir": "auto",
  "vendor": true,
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": ["no-unused-vars", "require-await", "no-explicit-any"]
    },
    "include": [
      "export.ts",
      "src/**/*.{ts,tsx}",
      "tests/**/*test.ts"
    ]
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "net": true,
      "env": true,
      "sys": true,
      "run": true,
      "ffi": true,
      "import": true
    },
    "include": [
      "tests/**/*test.ts"
    ],
    "exclude": [
      "export.ts",
      "example/**/*.{ts,tsx}"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "trailingCommas": "always",
    "json.trailingCommas": "never",
    "operatorPosition": "maintain",
    "jsx.bracketPosition": "sameLine",
    "jsx.forceNewLinesSurroundingContent": true,
    "jsx.multiLineParens": "always",
    "newLineKind": "lf",
    "include": [
      "export.ts",
      "example/**/*.{ts,tsx}",
      "src/**/*.{ts,tsx}",
      "tests/**/*test.ts"
    ]
  },
  "unstable": ["bundle"],
  "exclude": [
      ".qwen/",
      ".vscode/",
      "vendor",
      "node_modules",
      "snapshots",
      "docs"
    ]
}